# Server
PORT=4173
HOST=0.0.0.0

# Bootstrap admin
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me_admin_password

# Session security
SESSION_TTL_SEC=2592000
COOKIE_SECURE=false

# Rate limits
AUTH_RATE_LIMIT_WINDOW_MS=60000
AUTH_RATE_LIMIT_MAX=20
PAYMENTS_RATE_LIMIT_WINDOW_MS=60000
PAYMENTS_RATE_LIMIT_MAX=40

# Payment config
TELEGRAM_BOT_USERNAME=@username122333bot
TON_WALLET_ADDRESS=put_wallet_here
TELEGRAM_BOT_TOKEN=put_your_token_here
USDT_RATE_RUB=95
INVOICE_TTL_SEC=86400

# Data governance
CONSENT_REQUIRED=true
RETENTION_DAYS=90

# Infra wiring
DATABASE_URL=postgres://odkb:odkb_local_password@localhost:5432/odkb
REDIS_URL=redis://localhost:6379

# Webhooks
WEBHOOK_SECRET=put_webhook_secret_here

# Telemetry
TELEMETRY_ENABLED=true
