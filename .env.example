# Server
PORT=4173
HOST=0.0.0.0

# Bootstrap admin (change in production)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me_admin_password

# Optional role upgrade code (member -> analyst)
ROLE_ELEVATION_CODE=put_secure_role_code_here

# Session security
SESSION_TTL_SEC=2592000
COOKIE_SECURE=false

# Rate limits
AUTH_RATE_LIMIT_WINDOW_MS=60000
AUTH_RATE_LIMIT_MAX=20
PAYMENTS_RATE_LIMIT_WINDOW_MS=60000
PAYMENTS_RATE_LIMIT_MAX=40

# Payments runtime config
TELEGRAM_BOT_USERNAME=@username122333bot
TON_WALLET_ADDRESS=put_wallet_here
TELEGRAM_BOT_TOKEN=put_your_token_here

# Telemetry
TELEMETRY_ENABLED=true
